<?xml version="1.0" encoding="utf-8"?>
<!--
  The app declares no permissions at all. It has no network access, no
  storage access, and no sensors. The game is a self-contained asset loaded
  into a local WebView; there is nothing for it to reach out to.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.starfleet.command"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Haptics only. Notably absent: android.permission.INTERNET. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hasFragileUserData="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
